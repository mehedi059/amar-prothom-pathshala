  "rhymes": [
    {
      "id": "rhyme_01",
      "title": "রঙিন সকাল",
      "text": "রঙিন সকাল হাসে, পাখি ডাকে গাছে।",
      "voice": "bn-BD-NabanitaNeural",
      "audio": "rhyme_01.mp3"
    },
    {
      "id": "rhyme_02",
      "title": "ছোট্ট পাখি",
      "text": "ছোট্ট পাখি ডানা মেলে, উড়ে যায় নীল আকাশে।",
      "voice": "bn-BD-NabanitaNeural",
      "audio": "rhyme_02.mp3"
    },
    {
      "id": "rhyme_03",
      "title": "আমার বই",
      "text": "আমার বই, সবার সই, পড়তে বসি মন দিয়ে।",
      "voice": "bn-BD-NabanitaNeural",
      "audio": "rhyme_03.mp3"
    },
    {
      "id": "rhyme_04",
      "title": "ফুলের বাগান",
      "text": "ফুলের বাগান, রঙের মেলা, প্রজাপতি করে খেলা।",
      "voice": "bn-BD-NabanitaNeural",
      "audio": "rhyme_04.mp3"
    },
    {
      "id": "rhyme_05",
      "title": "টুপটাপ বৃষ্টি",
      "text": "টুপটাপ বৃষ্টি পড়ে, ব্যাঙটি নাচে ঘরের পরে।",
      "voice": "bn-BD-NabanitaNeural",
      "audio": "rhyme_05.mp3"
    }
  ]
