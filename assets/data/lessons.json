  "rhymes": [
    {
      "title": "ছোট্ট পাখি",
      "text": "ছোট্ট পাখি ডাকে, ভোরের আলো ফাঁকে।\nডানা মেলে উড়ে যায়, নীল আকাশের বাঁকে।",
      "audio": "assets/audio/rhymes/01.mp3"
    },
    {
      "title": "রঙিন ঘুড়ি",
      "text": "রঙিন ঘুড়ি উড়ে, মেঘের দেশে ঘুরে।\nহাসি খুশি ছোট্ট মন, খেলি সবাই মিলে।",
      "audio": "assets/audio/rhymes/02.mp3"
    },
    {
      "title": "আমার বই",
      "text": "আমার ছোট্ট বই, কত ছবি কই।\nপড়ি শিখি প্রতিদিন, আনন্দেরই সই।",
      "audio": "assets/audio/rhymes/03.mp3"
    },
    {
      "title": "বৃষ্টি",
      "text": "টাপুর টুপুর বৃষ্টি পড়ে, পাতার উপর জল।\nছোট্ট নদী গান গেয়ে যায়, দোলে শাপলা দল।",
      "audio": "assets/audio/rhymes/04.mp3"
    },
    {
      "title": "সকালের সূর্য",
      "text": "সকালের সূর্য হাসে, সোনার আলো ঘাসে।\nপড়তে বসি খুশির মনে, নতুন দিনের আশে।",
      "audio": "assets/audio/rhymes/05.mp3"
    }
  ]
}